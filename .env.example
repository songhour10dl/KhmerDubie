# OmniRoute Configuration
OMNIROUTE_BASE_URL=http://localhost:8000
OMNIROUTE_API_KEY=your_api_key_here
OMNIROUTE_MODEL=gpt-4

# Speech-to-Text Provider
STT_PROVIDER=whisper
STT_API_KEY=optional_for_cloud_services
STT_MODEL=base

# Text-to-Speech Provider (Khmer)
TTS_PROVIDER=kiri
TTS_API_KEY=your_kiri_api_key_here
TTS_VOICE=khmer_female_1
TTS_BASE_URL=https://api.kiri.ai/v1

# Processing Settings
MAX_CONCURRENT_REQUESTS=3
REQUEST_TIMEOUT=300
TEMP_DIR=./temp
OUTPUT_DIR=./output

# FFmpeg Settings
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Audio Settings
AUDIO_CODEC=aac
AUDIO_BITRATE=128k
AUDIO_SAMPLE_RATE=48000
